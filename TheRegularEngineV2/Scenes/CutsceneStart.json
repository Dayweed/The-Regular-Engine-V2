         "m_IsDialogue": false,
         "m_IsFading": false,
         "m_IsVisible": true,
         "m_Speed": 20.0,
         "m_TextContent": "Ready to have the grandest time of your lives? Then see you there!\n\nYours Sincerely,\nNolan the Golden"
