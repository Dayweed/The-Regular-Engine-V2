      5,
      18874541,
      {
         "m_Color": [
            0.15830117464065552,
            0.04828491806983948,
            0.04828491806983948,
            1.0
         ],
         "m_FadingSpeed": 0.0,
         "m_FontType": "JuaRegular",
         "m_IsDialogue": false,
         "m_IsFading": false,
         "m_IsVisible": true,
         "m_Speed": 0.0,
         "m_TextContent": "Dear Holey & Moley,\n\nGood tidings, mole brethren! I'm holding the grandest of parties at the town\nsquare, but this party is no ordinary one! 'Tis is a party only for the most\ndeserving, the most dapper, the most party-centric of mole society!\n\nShould you accept the invitation, there are standards to be met."
      },
      1048730,
      {
         "m_Color": [
            0.1568627506494522,
            0.0470588244497776,
            0.0470588244497776,
            1.0
         ],
         "m_FadingSpeed": 0.0,
         "m_FontType": "JuaRegular",
         "m_IsDialogue": false,
         "m_IsFading": false,
         "m_IsVisible": true,
         "m_Speed": 0.0,
         "m_TextContent": "Ready to have the grandest time of your lives? Then see you there!\n\nYours Sincerely,\nNolan the Golden"
      },
      1048720,
      {
         "m_Color": [
            0.1568627506494522,
            0.0470588244497776,
            0.0470588244497776,
            1.0
         ],
         "m_FadingSpeed": 0.0,
         "m_FontType": "JuaRegular",
         "m_IsDialogue": false,
         "m_IsFading": false,
         "m_IsVisible": true,
         "m_Speed": 0.0,
         "m_TextContent": "1) There are holes in walls scattered around the land, only by fitting through\nthem precisely, will you get closer to the party itself."
      },
      1048719,
      {
         "m_Color": [
            0.1568627506494522,
            0.0470588244497776,
            0.0470588244497776,
            1.0
         ],
         "m_FadingSpeed": 0.0,
         "m_FontType": "JuaRegular",
         "m_IsDialogue": false,
         "m_IsFading": false,
         "m_IsVisible": true,
         "m_Speed": 0.0,
         "m_TextContent": "2) I expect fashion of the highest calibre. We have a fiesta theme going so\nstick to it!"
      },
      1048731,
      {
         "m_Color": [
            0.1568627506494522,
            0.0470588244497776,
            0.0470588244497776,
            1.0
         ],
         "m_FadingSpeed": 0.0,
         "m_FontType": "JuaRegular",
         "m_IsDialogue": false,
         "m_IsFading": false,
         "m_IsVisible": true,
         "m_Speed": 0.0,
         "m_TextContent": "3) Entertainment! The grandest party is incomplete without music, bring something\nentertaining for everyone!"
      }
